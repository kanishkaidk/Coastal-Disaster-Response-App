# API Keys - Copy this to .env and add your actual keys
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# API Endpoints
API_BASE_URL=https://api.coast-kavach.com
MAPBOX_STYLE_URL=mapbox://styles/mapbox/satellite-streets-v11

# Development/Production flags
NODE_ENV=development
API_TIMEOUT=30000

# Social Media APIs (optional)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
FACEBOOK_APP_ID=your_facebook_app_id_here

# Government APIs (All FREE - No keys needed!)
IMD_API_URL=https://city.imd.gov.in/api/cityweather.php?id=42182
NDMA_API_URL=https://sachet.ndma.gov.in
INCOIS_LAS_URL=https://las.incois.gov.in/thredds/catalog.xml
INCOIS_ERDDAP_URL=https://erddap.incois.gov.in/erddap/index.json
INCOIS_PFZ_URL=https://incois.gov.in/MarineFisheries/PfzAdvisory
