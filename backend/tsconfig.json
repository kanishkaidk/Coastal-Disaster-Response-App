{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2022",
    "moduleResolution": "Node",
    "outDir": "dist",
    "baseUrl": "./",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@app/*": ["src/*"]
    }
  },
  "include": ["./src/**/*", "./prisma/**/*", "./test/**/*"],
  "exclude": ["node_modules", "dist", "../src", "../assets", "../App.tsx", "../babel.config.js", "../global.css", "../nativewind-env.d.ts", "../package.json", "../app.json"]
}


